# -------------------------------------------------------------
# SARTHI ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# --- BACKEND CONFIGURATION (server/index.js) ---
# Gnani AI Voice API key ID (Header X-API-Key-ID)
# Sign up at https://api.vachana.ai and copy your API Key ID.
GNANI_API_KEY=your_gnani_api_key_here

# Gemini API key for photo identification, itinerary suggestions, and guide Q&A.
# Keep this value server-side; do not prefix it with VITE_.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Backend server port (default 5001)
PORT=5001

# Gnani base URL
GNANI_BASE_URL=https://api.vachana.ai

# CORS allowed origin
CORS_ORIGIN=*

# --- FRONTEND CONFIGURATION (Vite React Client) ---
# Target backend URL for Vite dev proxy or decoupled deployments (optional)
# VITE_BACKEND_URL=http://localhost:5001
# VITE_API_BASE_URL=/api
